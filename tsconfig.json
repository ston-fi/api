{
  "compilerOptions": {
    // TS is used for typechecking only; tsdown handles build output
    "noEmit": true,
    "rootDir": "./src",

    // Explicit defaults to keep behavior stable across TS releases
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",

    // Strict typechecking options
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,

    // Skip typechecking of `.d.ts` files (e.g. from dependencies)
    "skipLibCheck": true
  },
  "include": ["src"]
}
