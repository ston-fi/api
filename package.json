{
  "name": "@ston-fi/api",
  "version": "0.31.0",
  "description": "Typescript client for Ston.fi Http API",
  "license": "MIT",
  "homepage": "https://github.com/ston-fi/api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ston-fi/api.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "cleanup": "rm -rf coverage dist node_modules build-report-*.html",
    "dev": "tsdown --sourcemap --watch ./src",
    "build": "tsdown",
    "lint": "pnpm run /^lint:.*/",
    "lint:tsc": "tsc --noEmit -p tsconfig.json --composite false --skipLibCheck",
    "lint:oxlint": "oxlint",
    "format": "pnpm run /^format:.*/",
    "format:oxfmt": "oxfmt",
    "test": "pnpm run /^test:.*/",
    "test:unit": "vitest",
    "prepublishOnly": "pnpm format && pnpm lint && pnpm build"
  },
  "dependencies": {
    "camelcase-keys": "9.1.3",
    "decamelize-keys": "2.0.1",
    "ofetch": "1.4.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "lefthook": "2.1.1",
    "oxfmt": "0.33.0",
    "oxlint": "1.48.0",
    "publint": "0.3.17",
    "rollup-plugin-visualizer": "6.0.5",
    "tsdown": "0.20.3",
    "typescript": "5.9.3",
    "vitest": "4.0.17"
  }
}
